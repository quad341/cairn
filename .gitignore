# The SQLite index is a rebuildable materialized view over the md frontmatter.
# Bodies are the source of truth; the index is disposable — never committed.
index/*.sqlite
index/*.sqlite-*
index/*.db
index/*.db-*

# Editor / OS noise
*.swp
.DS_Store

# make build output
/cairn

# Backfill exports/proposals contain private store content and are runtime-only.
/cairn-backfill-*.json
/cairn-backfill-*.jsonl
/backfill-work*.json
/backfill-work*.jsonl
/backfill-proposals*.json
/backfill-proposals*.jsonl
/work.jsonl

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
